generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @db.Uuid
  email     String?
  name      String?
  avatarUrl String? @map("avatar_url")

  embeds       Embed[]
  subscription Subscription?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

enum Plan {
  FREE
  PRO

  @@map("plan")
}

enum BillingInterval {
  MONTHLY
  YEARLY

  @@map("billing_interval")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED

  @@map("subscription_status")
}

enum EmbedTheme {
  LIGHT
  DARK
  SYSTEM

  @@map("embed_theme")
}

model Embed {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  title     String
  notionUrl String @map("notion_url") @db.Text
  slug      String @unique

  // Appearance
  theme        EmbedTheme @default(LIGHT)
  fullWidth    Boolean    @default(true) @map("full_width")
  width        Int        @default(640)
  fullHeight   Boolean    @default(false) @map("full_height")
  height       Int        @default(700)
  border       Boolean    @default(false)
  borderWidth  Int        @default(1) @map("border_width") @db.SmallInt
  borderColor  String     @default("#e5e7eb") @map("border_color")
  borderRadius Int        @default(8) @map("border_radius")

  // Premium customization
  customCss     String? @map("custom_css") @db.Text
  hideWatermark Boolean @default(false) @map("hide_watermark")

  // Embed state
  isActive Boolean @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("embeds")
}

model Subscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  plan            Plan               @default(PRO)
  billingInterval BillingInterval    @map("billing_interval")
  status          SubscriptionStatus

  provider               String
  providerCustomerId     String? @map("provider_customer_id")
  providerSubscriptionId String? @unique @map("provider_subscription_id")

  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([providerCustomerId])
  @@map("subscriptions")
}
